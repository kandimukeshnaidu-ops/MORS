{
  "expo": {
    "name": "MORS",
    "slug": "mors",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mors",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#141414"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mors.app",
      "infoPlist": {
        "NSCameraUsageDescription": "MORS uses the camera to capture food memories.",
        "NSPhotoLibraryUsageDescription": "MORS accesses photos to select dishes you experienced."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141414"
      },
      "package": "com.mors.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
