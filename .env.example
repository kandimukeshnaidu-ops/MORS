# ==========================================
# MORS Environment Variables
# ==========================================

# Environment Mode: local | staging | production
APP_ENV=local

# Supabase (Public Client)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase (Server-Side Only - NEVER expose to client or prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# PostHog Analytics (Client Public)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry Error Monitoring (Server & Client)
SENTRY_DSN=
